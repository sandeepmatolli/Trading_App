# ============================================================
# GROWW AUTHENTICATION
# ============================================================
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ============================================================
# GROWW MARKET SETTINGS
# ============================================================
GROWW_EXCHANGE=NSE
GROWW_SEGMENT=CASH

# ============================================================
# SCREENER
# ============================================================
SCREENER_CSV_PATH=stocks_screen.csv
STRICT_CORE50=false
RESULT_FRESHNESS_MONTHS=4

# ============================================================
# MARKET DATA
# ============================================================
DEFAULT_HOURLY_HISTORY_DAYS=730
DEFAULT_SETUP_15M_DAYS=89

# Conservative request windows. These are intentionally smaller than
# Groww's documented maxima because large requests produced silent holes
# during live testing on some symbols.
GROWW_HOURLY_REQUEST_CHUNK_DAYS=60
GROWW_15M_REQUEST_CHUNK_DAYS=30
GROWW_GAP_REPAIR_CHUNK_DAYS=14
GROWW_GAP_REPAIR_MAX_PASSES=2

NSE_SESSION_START=09:15
NSE_SESSION_END=15:30

# Current/recent data must be fresh and continuous.
MARKET_DATA_MAX_AGE_DAYS=7
MARKET_DATA_MAX_DAILY_GAP_DAYS=14
MARKET_DATA_RECENT_CONTINUITY_DAYS=365
MARKET_DATA_MIN_DAILY_COVERAGE_RATIO=0.55

# 75m setup quality.
# Each 75m window has five expected 15m source candles. We never fabricate
# missing 15m candles. A 75m bar with >=3 real source candles is "usable".
MARKET_DATA_SETUP_MIN_SOURCE_BARS=3
MARKET_DATA_MIN_SETUP_BARS=80

# Fatal floor: usable 75m bars / expected 75m windows in the setup horizon.
MARKET_DATA_MIN_SETUP_USABLE_EXPECTED_RATIO=0.40

# Candidate-grade floor. Data may still be analyzed below this value, but
# the AI validator must keep the symbol on WATCH rather than CANDIDATE.
MARKET_DATA_CANDIDATE_SETUP_USABLE_EXPECTED_RATIO=0.65

# ============================================================
# APPLICATION
# ============================================================
DEFAULT_MAX_SYMBOLS=20

# ============================================================
# NEWS
# ============================================================
NEWS_RSS_URLS=