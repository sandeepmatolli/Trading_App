# ============================================================
# GROWW AUTHENTICATION
# ============================================================
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ============================================================
# GROWW MARKET SETTINGS
# ============================================================
GROWW_EXCHANGE=NSE
GROWW_SEGMENT=CASH

# ============================================================
# SCREENER
# ============================================================
SCREENER_CSV_PATH=stocks_screen.csv
STRICT_CORE50=false
RESULT_FRESHNESS_MONTHS=4

# ============================================================
# MARKET DATA
# ============================================================
DEFAULT_HOURLY_HISTORY_DAYS=730
DEFAULT_SETUP_15M_DAYS=89

# Conservative request windows. These are intentionally smaller than
# Groww's documented request maxima because a large 1H request was observed
# to return a silent historical hole during live testing.
GROWW_HOURLY_REQUEST_CHUNK_DAYS=60
GROWW_15M_REQUEST_CHUNK_DAYS=30
GROWW_GAP_REPAIR_CHUNK_DAYS=14
GROWW_GAP_REPAIR_MAX_PASSES=2

NSE_SESSION_START=09:15
NSE_SESSION_END=15:30

MARKET_DATA_MAX_AGE_DAYS=7
MARKET_DATA_MAX_DAILY_GAP_DAYS=14
MARKET_DATA_MIN_DAILY_COVERAGE_RATIO=0.55
MARKET_DATA_MIN_SETUP_BARS=20

# ============================================================
# APPLICATION
# ============================================================
DEFAULT_MAX_SYMBOLS=20

# ============================================================
# NEWS
# ============================================================
NEWS_RSS_URLS=
