# ============================================================
# GROWW AUTHENTICATION
# ============================================================
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# ============================================================
# GROWW MARKET SETTINGS
# ============================================================
GROWW_EXCHANGE=NSE
GROWW_SEGMENT=CASH

# Opt-in SDK guard; these defaults preserve the existing fetch behaviour.
# This guard applies per child Python process to SDK instrument lookups and
# historical-candle calls only, not the account-wide Groww API quota.
GROWW_SDK_MIN_START_GAP_SECONDS=0
GROWW_SDK_MAX_CALLS_PER_CHILD=0
GROWW_SDK_CALL_TELEMETRY=false

# ============================================================
# SCREENER
# ============================================================
SCREENER_CSV_PATH=stocks_screen.csv
STRICT_CORE50=false
RESULT_FRESHNESS_MONTHS=4

# ============================================================
# MARKET DATA
# ============================================================
DEFAULT_HOURLY_HISTORY_DAYS=730
DEFAULT_SETUP_15M_DAYS=89

GROWW_HOURLY_REQUEST_CHUNK_DAYS=60
GROWW_15M_REQUEST_CHUNK_DAYS=30
GROWW_GAP_REPAIR_CHUNK_DAYS=14
GROWW_GAP_REPAIR_MAX_PASSES=2

NSE_SESSION_START=09:15
NSE_SESSION_END=15:30

MARKET_DATA_MAX_AGE_DAYS=7
MARKET_DATA_MAX_DAILY_GAP_DAYS=14
MARKET_DATA_RECENT_CONTINUITY_DAYS=365
MARKET_DATA_MIN_DAILY_COVERAGE_RATIO=0.55

MARKET_DATA_SETUP_MIN_SOURCE_BARS=3
MARKET_DATA_MIN_SETUP_BARS=80
MARKET_DATA_MIN_SETUP_USABLE_EXPECTED_RATIO=0.40
MARKET_DATA_CANDIDATE_SETUP_USABLE_EXPECTED_RATIO=0.65

# ============================================================
# APPLICATION
# ============================================================
DEFAULT_MAX_SYMBOLS=20

# ============================================================
# OFFICIAL NSE CORPORATE INFORMATION
# ============================================================
NSE_ANNOUNCEMENTS_RSS_URL=https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml
NSE_CORPORATE_ACTIONS_RSS_URL=https://nsearchives.nseindia.com/content/RSS/Corporate_action.xml
NSE_FINANCIAL_RESULTS_RSS_URL=https://nsearchives.nseindia.com/content/RSS/Financial_Results.xml
NSE_BOARD_MEETINGS_RSS_URL=https://nsearchives.nseindia.com/content/RSS/Board_Meetings.xml

NEWS_EVENT_LOOKBACK_DAYS=14
NEWS_SOURCE_MAX_STALE_DAYS=7
NEWS_MAX_MATCHED_EVENTS=10
NEWS_RSS_URLS=

# Persistent normalized NSE RSS cache
NEWS_CACHE_ENABLED=true
NEWS_CACHE_REFRESH_MINUTES=15
NEWS_FETCH_MAX_ATTEMPTS=3
NEWS_FETCH_RETRY_BASE_SECONDS=0.5
NEWS_FETCH_RETRY_MAX_SECONDS=2.0
NEWS_RETRY_COOLDOWN_MINUTES=5

# ============================================================
# HISTORICAL NSE CORPORATE-ACTION CONFIRMATION
# ============================================================
# This adapter is used only when SMC detects a suspicious price discontinuity.
# It must fail closed if NSE changes/blocks the web endpoint.
NSE_WEB_BASE_URL=https://www.nseindia.com
NSE_CORPORATE_ACTIONS_API_URL=https://www.nseindia.com/api/corporates-corporateActions
NSE_HISTORICAL_CA_TIMEOUT_SECONDS=20
NSE_HISTORICAL_CA_PADDING_DAYS=7

# Persistent historical corporate-action query cache
NSE_HISTORICAL_CA_CACHE_ENABLED=true
NSE_HISTORICAL_CA_CACHE_REFRESH_DAYS=30
NSE_HISTORICAL_CA_MAX_ATTEMPTS=3
NSE_HISTORICAL_CA_RETRY_BASE_SECONDS=0.75
NSE_HISTORICAL_CA_RETRY_MAX_SECONDS=3.0
NSE_HISTORICAL_CA_RETRY_COOLDOWN_MINUTES=30